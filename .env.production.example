# Copy this file to `.env.production` ON THE EC2 BOX and fill in real values.
# `.env.production` is gitignored — it never gets committed. Keep the real one
# only on the server (and a backup somewhere safe).

# ── Database (AWS RDS) ────────────────────────────────────────────────────────
# Use the RDS endpoint. sslmode=require is recommended for RDS.
DATABASE_URL=postgresql://USER:PASSWORD@your-db.xxxxxx.ap-south-1.rds.amazonaws.com:5432/v2e_prod?schema=public&sslmode=require

# ── Auth (JWT) ────────────────────────────────────────────────────────────────
# Use long random strings (min 32 chars). Generate with:  openssl rand -base64 48
JWT_SECRET=CHANGE-ME-min-32-chars
JWT_REFRESH_SECRET=CHANGE-ME-different-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── URLs ──────────────────────────────────────────────────────────────────────
# Public URL of the frontend — used to build sign-in links in emails.
FRONTEND_URL=https://v2e.rgbindia.com

# ── Transactional email (SMTP) ────────────────────────────────────────────────
# SMTP_PASS is a 16-char Google App Password, not the account password.
# Leave SMTP_HOST/USER/PASS blank to log emails to the console instead of sending.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=noreply@rgbindia.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM=noreply@rgbindia.com

# ── Web Push (VAPID) ──────────────────────────────────────────────────────────
# Generate once with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@rgbindia.com

# ── Cloudflare R2 (file attachments) ──────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

# ── Google Calendar sync (optional) ───────────────────────────────────────────
# 32-byte key for encrypting stored OAuth tokens (AES-256-GCM).
# Generate with:  openssl rand -base64 32
GCAL_ENC_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://v2e.rgbindia.com/api/v1/auth/google/callback
