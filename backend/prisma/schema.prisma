generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OrgStatus {
  active
  inactive
  pending_setup
}


enum BehaviorType {
  expected_behavior
  unacceptable_behavior
}

enum RoleLevel {
  junior
  mid
  senior
  lead
  head
}

enum EmploymentType {
  full_time
  part_time
  contract
}

enum EmployeeStatus {
  active
  inactive
  on_leave
}

enum AnnouncementType {
  announcement
  circular
}

enum AnnouncementPriority {
  normal
  important
  urgent
}

enum CommunicationScope {
  company_wide
  department
}

enum BoardInteractionMode {
  read_only
  comments_only
  comments_and_reactions
}

enum ConversationType {
  direct
  group
}

enum ChatMemberRole {
  admin
  member
}

enum ContentType {
  video
  document
  url
  article
}

enum LearningPathStatus {
  draft
  published
  archived
}

enum AssignmentStatus {
  not_started
  in_progress
  completed
}

enum SequentialMode {
  sequential
  free_form
}

enum CompletionType {
  manual
  auto_opened
}

model OrganizationGroup {
  id            String         @id @default(uuid())
  name          String
  slug          String         @unique
  description   String?
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt
  organizations Organization[]

  @@map("organization_groups")
}

model Organization {
  id         String    @id @default(uuid())
  name       String
  slug       String    @unique
  logo_url   String?
  industry   String?
  country    String?
  timezone   String?
  status     OrgStatus @default(pending_setup)
  group_id   String?
  group      OrganizationGroup? @relation(fields: [group_id], references: [id])
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  // ─── Simulated clock (test orgs only) ─────────────────────────────────────────
  is_test            Boolean   @default(false) // test client → controllable clock
  sim_epoch          DateTime?                 // the simulated instant last set
  sim_anchor         DateTime?                 // real time when sim_epoch was set (ticking)
  sim_replayed_until DateTime?                 // simulated time engines have replayed up to

  members            OrganizationMember[]
  org_identity       OrgIdentity?
  culture_standards  CultureStandard[]
  departments        Department[]
  roles              Role[]
  employee_profiles  EmployeeProfile[]
  learning_paths     LearningPath[]
  company_policies   CompanyPolicy[]
  announcements      Announcement[]
  announcement_reads AnnouncementRead[]
  bulletin_boards    BulletinBoard[]
  bulletin_posts     BulletinPost[]
  bulletin_comments  BulletinComment[]
  bulletin_reactions BulletinReaction[]
  knowledge_posts    KnowledgePost[]
  knowledge_comments KnowledgeComment[]
  knowledge_reactions KnowledgeReaction[]
  conversations      Conversation[]
  conversation_members ConversationMember[]
  messages           Message[]
  module_entitlements OrgModuleEntitlement[]

  @@map("organizations")
}

model OrganizationMember {
  id              String     @id @default(uuid())
  organization_id String
  user_id         String
  is_admin        Boolean    @default(false) // platform-admin flag — governs admin leaves ONLY, never feature access
  is_active       Boolean    @default(true)
  joined_at       DateTime   @default(now())

  organization Organization @relation(fields: [organization_id], references: [id])
  user         User         @relation(fields: [user_id], references: [id])

  @@unique([organization_id, user_id])
  @@map("organization_members")
}

model User {
  id              String   @id @default(uuid())
  name            String
  email           String
  password_hash   String
  is_super_admin  Boolean  @default(false)
  is_active       Boolean  @default(true)
  refresh_token   String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  organization_memberships OrganizationMember[]
  employee_profiles        EmployeeProfile[]
  headed_departments       Department[]       @relation("DepartmentHead")
  reports_to_employees     EmployeeProfile[]  @relation("ReportingTo")
  announcements            Announcement[]
  announcement_reads       AnnouncementRead[]
  bulletin_boards          BulletinBoard[]
  bulletin_posts           BulletinPost[]
  bulletin_comments        BulletinComment[]
  bulletin_reactions       BulletinReaction[]
  knowledge_posts          KnowledgePost[]
  knowledge_comments       KnowledgeComment[]
  knowledge_reactions      KnowledgeReaction[]
  conversations            Conversation[]
  conversation_memberships ConversationMember[]
  sent_messages            Message[]          @relation("SentMessages")
  owned_goals              Goal[]             @relation("GoalOwner")
  audit_logs               AuditLog[]
  organized_meetings       Meeting[]          @relation("MeetingOrganizer")
  meeting_attendances      MeetingAttendee[]  @relation("MeetingAttendeeUser")
  permission_overrides     UserPermissionOverride[]
  subject_overrides        UserSubjectOverride[]

  @@unique([email])
  @@map("users")
}

model OrgIdentity {
  id              String   @id @default(uuid())
  organization_id String   @unique
  philosophy      String?  @db.Text
  vision          String?  @db.Text
  mission         String?  @db.Text
  purpose         String?  @db.Text
  values          Json?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id])

  @@map("org_identities")
}

model CultureStandard {
  id              String       @id @default(uuid())
  organization_id String
  title           String
  description     String       @db.Text
  type            BehaviorType
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id])

  @@map("culture_standards")
}

model Department {
  id                   String   @id @default(uuid())
  organization_id      String
  name                 String
  description          String?  @db.Text
  parent_department_id String?
  head_user_id         String?
  color                String?  // optional hex override for the org-chart node; null = inherit branch hue
  position_x           Float    @default(0)
  position_y           Float    @default(0)
  // Assignee-visibility: when false, members of this dept can assign to their direct
  // manager and below, but not above the manager. Default true = no restriction.
  assignee_allow_upward Boolean @default(true)
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  organization        Organization    @relation(fields: [organization_id], references: [id])
  parent_department   Department?     @relation("DepartmentHierarchy", fields: [parent_department_id], references: [id])
  child_departments   Department[]    @relation("DepartmentHierarchy")
  head_user           User?           @relation("DepartmentHead", fields: [head_user_id], references: [id])
  roles               Role[]
  employee_profiles   EmployeeProfile[]
  announcements       Announcement[]
  bulletin_boards     BulletinBoard[]
  knowledge_posts     KnowledgePost[]
  goals               Goal[]

  @@map("departments")
}

model Role {
  id              String    @id @default(uuid())
  organization_id String
  department_id   String
  title           String
  job_description String?   @db.Text
  kra             Json?
  kpi             Json?
  level           RoleLevel @default(mid)
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  organization      Organization      @relation(fields: [organization_id], references: [id])
  department        Department        @relation(fields: [department_id], references: [id])
  employee_profiles EmployeeProfile[]
  permissions       RolePermission[]

  @@map("roles")
}

model EmployeeProfile {
  id                   String         @id @default(uuid())
  organization_id      String
  user_id              String
  role_id              String
  department_id        String
  reporting_to_user_id String?
  employee_code        String?
  date_of_joining      DateTime?
  date_of_birth        DateTime?
  marriage_date        DateTime?
  employment_type      EmploymentType @default(full_time)
  status               EmployeeStatus @default(active)
  created_at           DateTime       @default(now())
  updated_at           DateTime       @updatedAt

  organization         Organization             @relation(fields: [organization_id], references: [id])
  user                 User                     @relation(fields: [user_id], references: [id])
  role                 Role                     @relation(fields: [role_id], references: [id])
  department           Department               @relation(fields: [department_id], references: [id])
  reporting_to         User?                    @relation("ReportingTo", fields: [reporting_to_user_id], references: [id])
  learning_assignments LearningPathAssignment[]
  policy_assignments   CompanyPolicyAssignment[]

  @@unique([organization_id, user_id])
  @@map("employee_profiles")
}

model LearningPath {
  id                 String             @id @default(uuid())
  organization_id    String
  title              String
  description        String?            @db.Text
  thumbnail_url      String?
  status             LearningPathStatus @default(draft)
  mode               SequentialMode     @default(free_form)
  role_id            String?
  created_by_user_id String
  estimated_minutes  Int?
  created_at         DateTime           @default(now())
  updated_at         DateTime           @updatedAt

  organization Organization             @relation(fields: [organization_id], references: [id])
  items        LearningItem[]
  assignments  LearningPathAssignment[]

  @@map("learning_paths")
}

model LearningItem {
  id                String      @id @default(uuid())
  path_id           String
  title             String
  description       String?     @db.Text
  content_type      ContentType
  content_url       String?
  content_body      String?     @db.Text
  order_index       Int         @default(0)
  estimated_minutes Int?
  is_required       Boolean     @default(true)
  created_at        DateTime    @default(now())
  updated_at        DateTime    @updatedAt

  path     LearningPath           @relation(fields: [path_id], references: [id], onDelete: Cascade)
  progress LearningItemProgress[]

  @@map("learning_items")
}

model LearningPathAssignment {
  id                  String           @id @default(uuid())
  path_id             String
  employee_profile_id String
  assigned_by_user_id String
  assigned_at         DateTime         @default(now())
  due_date            DateTime?
  status              AssignmentStatus @default(not_started)
  completed_at        DateTime?

  path             LearningPath           @relation(fields: [path_id], references: [id])
  employee_profile EmployeeProfile        @relation(fields: [employee_profile_id], references: [id])
  item_progress    LearningItemProgress[]
  path_progress    LearningPathProgress?

  @@unique([path_id, employee_profile_id])
  @@map("learning_path_assignments")
}

model LearningItemProgress {
  id                  String           @id @default(uuid())
  assignment_id       String
  item_id             String
  employee_profile_id String
  status              AssignmentStatus @default(not_started)
  completion_type     CompletionType?
  started_at          DateTime?
  completed_at        DateTime?

  assignment LearningPathAssignment @relation(fields: [assignment_id], references: [id], onDelete: Cascade)
  item       LearningItem           @relation(fields: [item_id], references: [id], onDelete: Cascade)

  @@unique([assignment_id, item_id])
  @@map("learning_item_progress")
}

model LearningPathProgress {
  id                  String   @id @default(uuid())
  assignment_id       String   @unique
  employee_profile_id String
  path_id             String
  total_items         Int      @default(0)
  completed_items     Int      @default(0)
  progress_percent    Float    @default(0)
  last_activity_at    DateTime @default(now())

  assignment LearningPathAssignment @relation(fields: [assignment_id], references: [id], onDelete: Cascade)

  @@map("learning_path_progress")
}

// ─── Communication Layer ────────────────────────────────────────────────────

model Announcement {
  id                  String              @id @default(uuid())
  organization_id     String
  title               String
  body                String              @db.Text
  type                AnnouncementType    @default(announcement)
  scope               CommunicationScope  @default(company_wide)
  department_id       String?
  priority            AnnouncementPriority @default(normal)
  published_at        DateTime?
  expires_at          DateTime?
  created_by_user_id  String
  is_pinned           Boolean             @default(false)
  attachment_urls     Json?
  created_at          DateTime            @default(now())
  updated_at          DateTime            @updatedAt

  organization Organization      @relation(fields: [organization_id], references: [id])
  department   Department?       @relation(fields: [department_id], references: [id])
  created_by   User              @relation(fields: [created_by_user_id], references: [id])
  reads        AnnouncementRead[]

  @@map("announcements")
}

model AnnouncementRead {
  id              String   @id @default(uuid())
  organization_id String
  announcement_id String
  user_id         String
  read_at         DateTime @default(now())

  organization Organization @relation(fields: [organization_id], references: [id])
  announcement Announcement @relation(fields: [announcement_id], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [user_id], references: [id])

  @@unique([announcement_id, user_id])
  @@map("announcement_reads")
}

model BulletinBoard {
  id                  String               @id @default(uuid())
  organization_id     String
  name                String
  description         String?              @db.Text
  scope               CommunicationScope   @default(company_wide)
  department_id       String?
  interaction_mode    BoardInteractionMode @default(comments_and_reactions)
  created_by_user_id  String
  is_active           Boolean              @default(true)
  created_at          DateTime             @default(now())
  updated_at          DateTime             @updatedAt

  organization Organization    @relation(fields: [organization_id], references: [id])
  department   Department?     @relation(fields: [department_id], references: [id])
  created_by   User            @relation(fields: [created_by_user_id], references: [id])
  posts        BulletinPost[]

  @@map("bulletin_boards")
}

model BulletinPost {
  id                  String   @id @default(uuid())
  organization_id     String
  bulletin_board_id   String
  title               String
  body                String   @db.Text
  attachment_urls     Json?
  is_pinned           Boolean  @default(false)
  created_by_user_id  String
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  organization   Organization       @relation(fields: [organization_id], references: [id])
  bulletin_board BulletinBoard      @relation(fields: [bulletin_board_id], references: [id], onDelete: Cascade)
  created_by     User               @relation(fields: [created_by_user_id], references: [id])
  comments       BulletinComment[]
  reactions      BulletinReaction[]

  @@map("bulletin_posts")
}

model BulletinComment {
  id                  String   @id @default(uuid())
  organization_id     String
  bulletin_post_id    String
  body                String   @db.Text
  created_by_user_id  String
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  organization  Organization @relation(fields: [organization_id], references: [id])
  bulletin_post BulletinPost @relation(fields: [bulletin_post_id], references: [id], onDelete: Cascade)
  created_by    User         @relation(fields: [created_by_user_id], references: [id])

  @@map("bulletin_comments")
}

model BulletinReaction {
  id                  String   @id @default(uuid())
  organization_id     String
  bulletin_post_id    String
  user_id             String
  emoji               String
  created_at          DateTime @default(now())

  organization  Organization @relation(fields: [organization_id], references: [id])
  bulletin_post BulletinPost @relation(fields: [bulletin_post_id], references: [id], onDelete: Cascade)
  user          User         @relation(fields: [user_id], references: [id])

  @@unique([bulletin_post_id, user_id, emoji])
  @@map("bulletin_reactions")
}

model KnowledgePost {
  id                  String             @id @default(uuid())
  organization_id     String
  title               String?
  body                String             @db.Text
  scope               CommunicationScope @default(company_wide)
  department_id       String?
  tags                Json?
  is_pinned           Boolean            @default(false)
  attachment_urls     Json?
  created_by_user_id  String
  created_at          DateTime           @default(now())
  updated_at          DateTime           @updatedAt

  organization Organization          @relation(fields: [organization_id], references: [id])
  department   Department?           @relation(fields: [department_id], references: [id])
  created_by   User                  @relation(fields: [created_by_user_id], references: [id])
  comments     KnowledgeComment[]
  reactions    KnowledgeReaction[]

  @@map("knowledge_posts")
}

model KnowledgeComment {
  id                  String   @id @default(uuid())
  organization_id     String
  knowledge_post_id   String
  body                String   @db.Text
  parent_comment_id   String?
  created_by_user_id  String
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  organization   Organization       @relation(fields: [organization_id], references: [id])
  knowledge_post KnowledgePost      @relation(fields: [knowledge_post_id], references: [id], onDelete: Cascade)
  parent_comment KnowledgeComment?  @relation("CommentReplies", fields: [parent_comment_id], references: [id])
  replies        KnowledgeComment[] @relation("CommentReplies")
  created_by     User               @relation(fields: [created_by_user_id], references: [id])

  @@map("knowledge_comments")
}

model KnowledgeReaction {
  id                  String   @id @default(uuid())
  organization_id     String
  knowledge_post_id   String
  user_id             String
  emoji               String
  created_at          DateTime @default(now())

  organization   Organization  @relation(fields: [organization_id], references: [id])
  knowledge_post KnowledgePost @relation(fields: [knowledge_post_id], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [user_id], references: [id])

  @@unique([knowledge_post_id, user_id, emoji])
  @@map("knowledge_reactions")
}

model Conversation {
  id                  String           @id @default(uuid())
  organization_id     String
  type                ConversationType @default(direct)
  name                String?
  avatar_url          String?
  created_by_user_id  String
  created_at          DateTime         @default(now())
  updated_at          DateTime         @updatedAt

  organization Organization         @relation(fields: [organization_id], references: [id])
  created_by   User                 @relation(fields: [created_by_user_id], references: [id])
  members      ConversationMember[]
  messages     Message[]

  @@map("conversations")
}

model ConversationMember {
  id              String         @id @default(uuid())
  organization_id String
  conversation_id String
  user_id         String
  role            ChatMemberRole @default(member)
  joined_at       DateTime       @default(now())
  last_read_at    DateTime       @default(now())

  organization Organization @relation(fields: [organization_id], references: [id])
  conversation Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [user_id], references: [id])

  @@unique([conversation_id, user_id])
  @@map("conversation_members")
}

model Message {
  id                  String   @id @default(uuid())
  organization_id     String
  conversation_id     String
  sender_user_id      String
  body                String   @db.Text
  attachment_urls     Json?
  reply_to_message_id String?
  is_deleted          Boolean  @default(false)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  organization     Organization @relation(fields: [organization_id], references: [id])
  conversation     Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  sender           User         @relation("SentMessages", fields: [sender_user_id], references: [id])
  reply_to_message Message?     @relation("MessageReplies", fields: [reply_to_message_id], references: [id])
  replies          Message[]    @relation("MessageReplies")

  @@map("messages")
}

// ─── Task Management Layer ──────────────────────────────────────────────────

enum TaskQuadrant {
  Q1
  Q2
  Q3
  Q4
}

enum TaskType {
  one_time
  recurring
}

enum CompletionMode {
  all_must_complete
  any_can_complete
}

enum ReminderType {
  assignee
  assigner
  cc
}

enum TaskActionType {
  created
  edited
  assigned
  reassigned
  status_changed
  completed
  reopened
  proof_attached
  checklist_updated
  escalated
  reminder_sent
  deleted
  comment_added
  comment_deleted
  file_attached
}

enum RecurringScheduleType {
  daily
  weekly
  monthly
  yearly
}

enum RecurringEndCondition {
  never
  on_date
  after_n
}

// All task tables use plain string IDs for cross-module references
// (no FK constraints to Organization/User/Department tables)
// This allows extraction as a standalone microservice.

model TaskMaster {
  id                          String   @id @default(uuid())
  organization_id             String   @unique
  task_creation_roles         Json     @default("[\"org_admin\",\"hr_manager\",\"employee\"]")
  task_edit_roles             Json     @default("[\"org_admin\",\"hr_manager\"]")
  task_delete_roles           Json     @default("[\"org_admin\"]")
  default_reminder_days_before Int     @default(1)
  default_reminder_frequency  String   @default("once")
  reopen_window_minutes       Int      @default(10)
  escalation_levels           Int      @default(2)
  archive_view_roles          Json     @default("[\"org_admin\"]")
  // Legacy base-mode fields — retained for rollback/reference; no longer read by the
  // resolver (base default is now fixed Hierarchy+Department, modulated by the per-dept
  // upward switch). See AssigneeVisibilityService.
  assignee_visibility_mode         String   @default("hierarchy_and_dept")
  assignee_custom_rules            Json?
  assignee_visibility_config_roles Json     @default("[\"org_admin\",\"hr_manager\"]")
  // New assignee-visibility model:
  assignee_master_override         Boolean  @default(false)
  assignee_full_visibility_roles   Json     @default("[\"org_admin\",\"hr_manager\"]")
  assignee_full_visibility_users   Json     @default("[]")
  assignee_exclude_departments     Json     @default("[]")
  assignee_exclude_roles           Json     @default("[]")
  created_at                  DateTime @default(now())
  updated_at                  DateTime @updatedAt

  @@map("task_masters")
}

// ─── Assignee Visibility (who appears in the assign-to / CC picker) ──────────────

enum AssigneeExceptionScope {
  user
  role
  department
}

enum AssigneeExceptionKind {
  widen // sees all active employees (excludes still apply)
  narrow // sees only the hand-picked shortlist (+ self); excludes do NOT apply
}

enum BridgeDepth {
  head_senior // target dept head + roles with level senior/lead/head
  whole_dept // everyone in the target dept
}

// A scoped override of the base default. Most-specific wins: user > role > department.
// References are plain ids (no FK) — the resolver skips orphans and dept deletion cleans up.
model AssigneeVisibilityException {
  id                  String                 @id @default(uuid())
  organization_id     String
  scope               AssigneeExceptionScope
  scope_user_id       String?
  scope_role          String?
  scope_department_id String?
  kind                AssigneeExceptionKind
  created_by          String?
  created_at          DateTime               @default(now())
  updated_at          DateTime               @updatedAt

  members AssigneeVisibilityExceptionMember[]

  @@index([organization_id, scope])
  @@map("assignee_visibility_exceptions")
}

// Hand-picked shortlist for a narrowing exception.
model AssigneeVisibilityExceptionMember {
  id           String                      @id @default(uuid())
  exception_id String
  user_id      String
  exception    AssigneeVisibilityException @relation(fields: [exception_id], references: [id], onDelete: Cascade)

  @@unique([exception_id, user_id])
  @@index([exception_id])
  @@map("assignee_visibility_exception_members")
}

// One-directional: members of from_department may additionally assign into to_department.
model AssigneeCrossDeptBridge {
  id                 String      @id @default(uuid())
  organization_id    String
  from_department_id String
  to_department_id   String
  depth              BridgeDepth @default(head_senior)
  created_by         String?
  created_at         DateTime    @default(now())

  @@unique([organization_id, from_department_id, to_department_id])
  @@index([organization_id, from_department_id])
  @@map("assignee_cross_dept_bridges")
}

// Audit trail for every assignee-visibility change.
model AssigneeVisibilityAuditLog {
  id              String   @id @default(uuid())
  organization_id String
  actor_user_id   String
  action          String
  target          Json?
  before          Json?
  after           Json?
  created_at      DateTime @default(now())

  @@index([organization_id, created_at])
  @@map("assignee_visibility_audit_logs")
}

model TaskCategory {
  id                    String   @id @default(uuid())
  organization_id       String
  name                  String
  description           String?
  color                 String   @default("#2563EB")
  created_by_user_id    String
  visible_to_departments Json    @default("[]")
  visible_to_roles      Json     @default("[]")
  is_active             Boolean  @default(true)
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  tasks Task[]

  @@map("task_categories")
}

model TaskPriority {
  id              String   @id @default(uuid())
  organization_id String
  label           String
  color           String   @default("#2563EB")
  order_index     Int      @default(0)
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  tasks Task[]

  @@map("task_priorities")
}

model TaskStatus {
  id              String   @id @default(uuid())
  organization_id String
  label           String
  type            String
  color           String   @default("#2563EB")
